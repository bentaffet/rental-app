PORT=4000
NODE_ENV=development

# Rotate any Bright Data token that has been pasted into a chat or shared doc.
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=gd_lz11l67o2cb3r0lkj3
BRIGHTDATA_API_BASE_URL=https://api.brightdata.com/datasets/v3

# Set this and pass the same value from Bright Data delivery auth/header settings.
BRIGHTDATA_WEBHOOK_SECRET=change-me-before-production

# Firebase Admin service account JSON from Firebase Console.
FIREBASE_SERVICE_ACCOUNT_JSON=


# Set false when Firebase is configured.
USE_LOCAL_DATASTORE=true
